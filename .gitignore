# 忽略 current 软链接（由 switch 命令动态生成）
current

# 忽略编辑器临时文件
*~
*.swp
*.swo
.*.swp

# 忽略 macOS 系统文件
.DS_Store

# 忽略 IDE 配置
.idea/
.vscode/
*.iml

# 忽略本地配置文件（包含 API Keys）
config-*.local.sh

# 忽略生成的工作目录
_bmad/
_bmad-output/
design-artifacts/

# 忽略 .claude 目录中的临时内容（大部分 skills）
.claude/skills/
.claude/memory/

# 但保留重要的 platform-switcher skill
!.claude/skills/platform-switcher/
